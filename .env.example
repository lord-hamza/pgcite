DATABASE_URL=postgresql://rag:rag@localhost:5432/rag

# extractive (offline, free) or anthropic
GENERATOR=extractive
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low

# When set, POST and DELETE routes require an X-API-Key header with this value
API_KEY=

TOP_K=5
CANDIDATES=40
RERANK_CANDIDATES=20
